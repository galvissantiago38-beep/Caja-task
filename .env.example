# Públicas (van al bundle del navegador)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
NEXT_PUBLIC_APP_URL=https://caja-task.vercel.app

# Privadas — NUNCA commitear ni exponer en el cliente.
# Service role bypassa toda la RLS. Solo en server actions / route handlers.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Resend (notificaciones por email)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="Caja Tasks <onboarding@resend.dev>"

# Si se define, TODAS las notificaciones del cron van a este correo único
# en vez de al correo de cada cajero asignado. Útil cuando aún no se
# verifica un dominio en Resend y se quiere centralizar la bandeja.
# Dejar vacío para que cada cajero reciba en su propio correo.
NOTIFICATIONS_TO=

# Cron (Vercel) — string aleatorio para autenticar las llamadas del cron
CRON_SECRET=string-random-largo
